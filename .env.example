# Required for Prisma and the app's API routes
# Use Supabase pooler / pgbouncer URL for runtime queries
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Use the direct database URL for Prisma migrations
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require"

# Required if you use the Vercel cron keep-alive endpoint
CRON_SECRET="replace-with-a-long-random-secret"

# Required for JWT authentication cookies
JWT_SECRET="replace-with-a-long-random-secret"

# Container/runtime settings
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"

# Optional: keep these only if your frontend or external tooling needs them
# They exist in the current project env, but are not referenced by the source code right now.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
