generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum BusStatus {
  active
  maintenance
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Bus {
  id         Int        @id @default(autoincrement())
  busNumber  String     @unique
  totalSeats Int        @default(40)
  type       String     @default("มาตรฐาน")
  status     BusStatus  @default(active)
  layout     Json?
  schedules  Schedule[]

  @@index([status])
  @@index([type])
}

model Route {
  id        Int            @id @default(autoincrement())
  routeName String
  stations  RouteStation[]
  schedules Schedule[]

  @@index([routeName])
}

model RouteStation {
  id          Int    @id @default(autoincrement())
  routeId     Int
  stationName String
  stopOrder   Int

  route    Route     @relation(fields: [routeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  pickups  Booking[] @relation("PickupStation")
  dropoffs Booking[] @relation("DropoffStation")

  @@unique([routeId, stopOrder])
}

model Schedule {
  id            Int      @id @default(autoincrement())
  busId         Int
  routeId       Int
  departureDate DateTime
  departureTime String

  bus      Bus       @relation(fields: [busId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  route    Route     @relation(fields: [routeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  bookings Booking[]

  @@unique([busId, departureDate, departureTime])
  @@index([departureDate, departureTime])
  @@index([routeId, departureDate])
  @@index([busId, departureDate])
}

model Booking {
  id               Int           @id @default(autoincrement())
  scheduleId       Int
  seatNumber       String
  passengerName    String?
  passengerPhone   String?
  pickupStationId  Int
  dropoffStationId Int
  price            Float         @default(0.0)
  status           BookingStatus @default(CONFIRMED)
  createdAt        DateTime      @default(now())

  schedule       Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  pickupStation  RouteStation @relation("PickupStation", fields: [pickupStationId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  dropoffStation RouteStation @relation("DropoffStation", fields: [dropoffStationId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([scheduleId, seatNumber])
  @@index([scheduleId, createdAt])
  @@index([passengerPhone])
  @@index([status])
}
