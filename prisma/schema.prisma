generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// แอดมินคนเดียว ไม่ต้องมีตาราง Member อื่น
model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

// ข้อมูลรถบัส (เช่น เบอร์รถ, ประเภทรถ)
model Bus {
  id          Int        @id @default(autoincrement())
  busNumber   String     @unique // เช่น "815-1", "VIP-01"
  totalSeats  Int        @default(40)
  schedules   Schedule[]
}

// เส้นทางหลัก (เช่น ราชสีมา - ระยอง)
model Route {
  id        Int            @id @default(autoincrement())
  routeName String
  stations  RouteStation[]
  schedules Schedule[]
}

// จุดจอดรายทาง (แอดมิน Custom ลำดับเองได้ เช่น ปักธงชัย, กบินทร์, บ่อวิน)
model RouteStation {
  id          Int    @id @default(autoincrement())
  routeId     Int
  stationName String
  stopOrder   Int    // ลำดับที่ 1, 2, 3...

  route       Route     @relation(fields: [routeId], references: [id])
  pickups     Booking[] @relation("PickupStation")
  dropoffs    Booking[] @relation("DropoffStation")
}

// รอบการวิ่งในแต่ละวัน
model Schedule {
  id            Int       @id @default(autoincrement())
  busId         Int
  routeId       Int
  departureDate DateTime
  departureTime String    // เช่น "08:30"
  
  bus           Bus       @relation(fields: [busId], references: [id])
  route         Route     @relation(fields: [routeId], references: [id])
  bookings      Booking[]
}

// การจองที่นั่ง (แอดมินเป็นคนคีย์ข้อมูลเองทั้งหมด)
model Booking {
  id               Int      @id @default(autoincrement())
  scheduleId       Int
  seatNumber       String   // เช่น "A1", "B2"
  passengerName    String?  // ชื่อลูกค้า
  passengerPhone   String?
  
  // จุดขึ้น-ลง ที่ระบุแยกรายที่นั่งตามที่คุณต้องการ
  pickupStationId  Int
  dropoffStationId Int
  
  price            Float    @default(0.0)
  status           String   @default("CONFIRMED") // CONFIRMED, CANCELLED
  createdAt        DateTime @default(now())

  schedule         Schedule     @relation(fields: [scheduleId], references: [id])
  pickupStation    RouteStation @relation("PickupStation", fields: [pickupStationId], references: [id])
  dropoffStation   RouteStation @relation("DropoffStation", fields: [dropoffStationId], references: [id])

  @@unique([scheduleId, seatNumber]) // ป้องกันการจองที่นั่งซ้ำในรอบเดียวกัน
}